Attribute VB_Name = "modSelfTest"
Option Explicit

' Self-test: reads scenarios and expected results from the hidden Test sheet
' (columns Scenario, Table, RowNo, then values; all cells text; no header row),
' runs the VBA engine on each scenario in memory and compares the outcome with
' the expected tables generated by the Python engine. Writes no sheet and shows
' no dialog in SelfTestSilent. It leaves the test data in the global state.

Private mData As Variant
Private mRows As Long
Private mCols As Long
Private mFails As String
Private mCurrent As String

' ------------------------------------------------------------------
' Sheet access
' ------------------------------------------------------------------

' Reads the Test sheet into mData (1-based, from A1). False when it is empty.
Private Function LoadSheet() As Boolean
    Dim ws As Worksheet
    Dim ur As Range
    Dim rng As Range
    Dim v As Variant
    Dim arr() As Variant

    LoadSheet = False
    mRows = 0
    mCols = 0
    Set ws = ThisWorkbook.Worksheets("Test")
    Set ur = ws.UsedRange
    Set rng = ws.Range(ws.Cells(1, 1), ws.Cells(ur.Row + ur.Rows.Count - 1, ur.Column + ur.Columns.Count - 1))
    If rng.Cells.Count = 1 Then
        ReDim arr(1 To 1, 1 To 1)
        arr(1, 1) = rng.Cells(1, 1).Value2
        mData = arr
    Else
        v = rng.Value2
        mData = v
    End If
    mRows = UBound(mData, 1)
    mCols = UBound(mData, 2)
    LoadSheet = True
End Function

' Text of a cell of mData; "" for Empty, errors and cells outside the data.
Private Function CellText(ByVal r As Long, ByVal c As Long) As String
    Dim v As Variant

    CellText = ""
    If r < 1 Then Exit Function
    If r > mRows Then Exit Function
    If c < 1 Then Exit Function
    If c > mCols Then Exit Function
    v = mData(r, c)
    If IsError(v) Then Exit Function
    If IsEmpty(v) Then Exit Function
    CellText = CStr(v)
End Function

' RowNo of a sheet row, or -1 when it is not a number.
Private Function RowNoOf(ByVal r As Long) As Long
    Dim t As String

    RowNoOf = -1
    t = Trim$(CellText(r, 3))
    If Len(t) = 0 Then Exit Function
    If Not IsNumeric(t) Then Exit Function
    RowNoOf = CLng(t)
End Function

Private Function IsTable(ByVal r As Long, ByVal tableName As String) As Boolean
    IsTable = (StrComp(LCase$(Trim$(CellText(r, 2))), tableName, vbBinaryCompare) = 0)
End Function

' Sheet row of table row rowNo inside first..last, or 0.
Private Function FindRow(ByVal first As Long, ByVal last As Long, ByVal tableName As String, ByVal rowNo As Long) As Long
    Dim r As Long

    FindRow = 0
    For r = first To last
        If IsTable(r, tableName) Then
            If RowNoOf(r) = rowNo Then
                FindRow = r
                Exit Function
            End If
        End If
    Next r
End Function

' Number of data rows (RowNo 1 and up) of a table inside first..last.
Private Function CountRows(ByVal first As Long, ByVal last As Long, ByVal tableName As String) As Long
    Dim r As Long
    Dim n As Long

    n = 0
    For r = first To last
        If IsTable(r, tableName) Then
            If RowNoOf(r) >= 1 Then n = n + 1
        End If
    Next r
    CountRows = n
End Function

' Fills a raw table like modIO.ReadSheetsToRaw: tbl(1 To rows, 1 To width),
' cnt = number of rows; unallocated when cnt is 0. Values start in column 4.
Private Sub LoadRaw(ByVal first As Long, ByVal last As Long, ByVal tableName As String, ByVal width As Long, _
                    ByRef tbl() As String, ByRef cnt As Long)
    Dim r As Long
    Dim c As Long
    Dim n As Long

    cnt = 0
    Erase tbl
    n = CountRows(first, last, tableName)
    If n = 0 Then Exit Sub
    ReDim tbl(1 To n, 1 To width)
    n = 0
    For r = first To last
        If IsTable(r, tableName) Then
            If RowNoOf(r) >= 1 Then
                n = n + 1
                For c = 1 To width
                    tbl(n, c) = CellText(r, 3 + c)
                Next c
            End If
        End If
    Next r
    cnt = n
End Sub

Private Function FirstLine(ByVal t As String) As String
    Dim p As Long

    p = InStr(1, t, vbLf, vbBinaryCompare)
    If p > 0 Then
        FirstLine = Left$(t, p - 1)
    Else
        FirstLine = t
    End If
End Function

Private Function Differs(ByVal got As String, ByVal expected As String) As Boolean
    Differs = (StrComp(got, expected, vbBinaryCompare) <> 0)
End Function

Private Sub AddFail(ByVal line As String)
    If Len(mFails) = 0 Then
        mFails = line
    Else
        mFails = mFails & vbLf & line
    End If
End Sub

' ------------------------------------------------------------------
' Comparisons. Each returns "" when equal, else the first difference.
' ------------------------------------------------------------------

Private Function CompareRoster(ByVal first As Long, ByVal last As Long) As String
    Dim hr As Long
    Dim er As Long
    Dim d As Long
    Dim k As Long
    Dim nExp As Long
    Dim got As String
    Dim want As String
    Dim dateTxt As String

    hr = FindRow(first, last, "expected_roster", 0)
    If hr = 0 Then
        CompareRoster = "roster: expected header row is missing"
        Exit Function
    End If
    For k = 0 To gSlotCount - 1
        got = gSlotName(k)
        want = CellText(hr, 6 + k)
        If Differs(got, want) Then
            CompareRoster = "roster header column " & CStr(k + 1) & ": got " & got & ", expected " & want
            Exit Function
        End If
    Next k
    want = CellText(hr, 6 + gSlotCount)
    If Len(want) > 0 Then
        CompareRoster = "roster header: unexpected extra slot column " & want
        Exit Function
    End If
    nExp = CountRows(first, last, "expected_roster")
    If nExp <> gDateCount Then
        CompareRoster = "roster rows: got " & CStr(gDateCount) & ", expected " & CStr(nExp)
        Exit Function
    End If
    For d = 0 To gDateCount - 1
        er = FindRow(first, last, "expected_roster", d + 1)
        If er = 0 Then
            CompareRoster = "roster: expected row " & CStr(d + 1) & " is missing"
            Exit Function
        End If
        dateTxt = modTypes.TextFromSerial(gDates(d))
        got = gHoliday(d)
        want = CellText(er, 4)
        If Differs(got, want) Then
            CompareRoster = "roster " & dateTxt & " Holiday: got " & got & ", expected " & want
            Exit Function
        End If
        want = CellText(er, 5)
        If Differs(dateTxt, want) Then
            CompareRoster = "roster " & dateTxt & " Date: got " & dateTxt & ", expected " & want
            Exit Function
        End If
        For k = 0 To gSlotCount - 1
            If gGrid(d, k) >= 0 Then
                got = gStaff(gGrid(d, k))
            Else
                got = "GAP"
            End If
            want = CellText(er, 6 + k)
            If Differs(got, want) Then
                CompareRoster = "roster " & dateTxt & " " & gSlotName(k) & ": got " & got & ", expected " & want
                Exit Function
            End If
        Next k
    Next d
    CompareRoster = ""
End Function

Private Function CompareReview(ByVal first As Long, ByVal last As Long) As String
    Dim er As Long
    Dim i As Long
    Dim nExp As Long
    Dim got As String
    Dim want As String

    nExp = CountRows(first, last, "expected_review")
    If nExp <> modReview.gRevCount Then
        CompareReview = "review rows: got " & CStr(modReview.gRevCount) & ", expected " & CStr(nExp)
        Exit Function
    End If
    For i = 1 To modReview.gRevCount
        er = FindRow(first, last, "expected_review", i)
        If er = 0 Then
            CompareReview = "review: expected row " & CStr(i) & " is missing"
            Exit Function
        End If
        got = modReview.gRev(i, 1)
        want = CellText(er, 4)
        If Differs(got, want) Then
            CompareReview = "review row " & CStr(i) & " Date: got " & got & ", expected " & want
            Exit Function
        End If
        got = modReview.gRev(i, 3)
        want = CellText(er, 6)
        If Differs(got, want) Then
            CompareReview = "review row " & CStr(i) & " Slot: got " & got & ", expected " & want
            Exit Function
        End If
        got = modReview.gRev(i, 4)
        want = CellText(er, 7)
        If Differs(got, want) Then
            CompareReview = "review row " & CStr(i) & " Rule not met: got " & got & ", expected " & want
            Exit Function
        End If
    Next i
    CompareReview = ""
End Function

Private Function CompareSummary(ByVal first As Long, ByVal last As Long) As String
    Dim er As Long
    Dim s As Long
    Dim nExp As Long
    Dim got As String
    Dim want As String
    Dim who As String

    nExp = CountRows(first, last, "expected_summary")
    If nExp <> gStaffCount + 1 Then
        CompareSummary = "summary rows: got " & CStr(gStaffCount + 1) & ", expected " & CStr(nExp)
        Exit Function
    End If
    For s = 0 To gStaffCount - 1
        er = FindRow(first, last, "expected_summary", s + 1)
        If er = 0 Then
            CompareSummary = "summary: expected row " & CStr(s + 1) & " is missing"
            Exit Function
        End If
        who = gStaff(s)
        got = who
        want = CellText(er, 4)
        If Differs(got, want) Then
            CompareSummary = "summary row " & CStr(s + 1) & " Staff name: got " & got & ", expected " & want
            Exit Function
        End If
        got = CStr(gActiveCount(s))
        want = CellText(er, 5)
        If Differs(got, want) Then
            CompareSummary = "summary " & who & " Active slots: got " & got & ", expected " & want
            Exit Function
        End If
        got = CStr(gEligible(s))
        want = CellText(er, 6)
        If Differs(got, want) Then
            CompareSummary = "summary " & who & " Eligible dates: got " & got & ", expected " & want
            Exit Function
        End If
        got = modReview.RatioText(gActiveCount(s), gEligible(s))
        want = CellText(er, 7)
        If Differs(got, want) Then
            CompareSummary = "summary " & who & " Ratio: got " & got & ", expected " & want
            Exit Function
        End If
        got = CStr(gStandbyCount(s))
        want = CellText(er, 8)
        If Differs(got, want) Then
            CompareSummary = "summary " & who & " Standby slots: got " & got & ", expected " & want
            Exit Function
        End If
    Next s
    er = FindRow(first, last, "expected_summary", gStaffCount + 1)
    If er = 0 Then
        CompareSummary = "summary: Spread row is missing"
        Exit Function
    End If
    want = CellText(er, 4)
    If Differs("Spread", want) Then
        CompareSummary = "summary last row label: got Spread, expected " & want
        Exit Function
    End If
    got = modReview.SpreadText()
    want = CellText(er, 7)
    If Differs(got, want) Then
        CompareSummary = "summary Spread: got " & got & ", expected " & want
        Exit Function
    End If
    CompareSummary = ""
End Function

' ------------------------------------------------------------------
' One scenario
' ------------------------------------------------------------------

' Applies the approve rows in order. "" when all were accepted.
Private Function ApplyApproveRows(ByVal first As Long, ByVal last As Long) As String
    Dim r As Long
    Dim j As Long
    Dim dTxt As String
    Dim slotTxt As String
    Dim staffTxt As String
    Dim ser As Long
    Dim dIdx As Long
    Dim kIdx As Long
    Dim sIdx As Long
    Dim ok As Boolean
    Dim note As String
    Dim label As String

    For r = first To last
        If IsTable(r, "approve") Then
            If RowNoOf(r) >= 1 Then
                dTxt = Trim$(CellText(r, 4))
                slotTxt = Trim$(CellText(r, 5))
                staffTxt = CellText(r, 6)
                label = "approve " & dTxt & " " & slotTxt & " " & Trim$(staffTxt)
                If Not modTypes.IsDateText(dTxt) Then
                    ApplyApproveRows = label & ": bad date"
                    Exit Function
                End If
                ser = modTypes.SerialFromText(dTxt)
                dIdx = -1
                For j = 0 To gDateCount - 1
                    If gDates(j) = ser Then dIdx = j
                Next j
                If dIdx < 0 Then
                    ApplyApproveRows = label & ": date is not a holiday date"
                    Exit Function
                End If
                kIdx = -1
                For j = 0 To gSlotCount - 1
                    If StrComp(gSlotName(j), slotTxt, vbBinaryCompare) = 0 Then kIdx = j
                Next j
                If kIdx < 0 Then
                    ApplyApproveRows = label & ": unknown slot"
                    Exit Function
                End If
                sIdx = modTypes.StaffIndex(staffTxt)
                If sIdx < 0 Then
                    ApplyApproveRows = label & ": unknown staff name"
                    Exit Function
                End If
                note = ""
                ok = modApprovals.ApplyApprovalCore(dIdx, kIdx, sIdx, note)
                If Not ok Then
                    ApplyApproveRows = label & ": rejected: " & note
                    Exit Function
                End If
            End If
        End If
    Next r
    ApplyApproveRows = ""
End Function

' Runs the scenario in sheet rows first..last. "" when it reproduces the
' expected results, else a description of the first difference.
Private Function RunScenario(ByVal first As Long, ByVal last As Long) As String
    Dim msgs As String
    Dim diff As String
    Dim chk As String

    LoadRaw first, last, "staff", 5, modTypes.gRawStaff, modTypes.gRawStaffRows
    LoadRaw first, last, "holidays", 3, modTypes.gRawHolidays, modTypes.gRawHolidaysRows
    LoadRaw first, last, "lastyear", 4, modTypes.gRawLastYear, modTypes.gRawLastYearRows
    LoadRaw first, last, "leave", 4, modTypes.gRawLeave, modTypes.gRawLeaveRows
    LoadRaw first, last, "settings", 2, modTypes.gRawSettings, modTypes.gRawSettingsRows

    msgs = modValidate.ValidateRaw()
    If Len(msgs) > 0 Then
        RunScenario = "validation: " & FirstLine(msgs)
        Exit Function
    End If

    modIO.BuildInputs
    modEngine.NewResult
    modEngine.SolveYear 0

    diff = ApplyApproveRows(first, last)
    If Len(diff) > 0 Then
        RunScenario = diff
        Exit Function
    End If

    modReview.BuildReview

    diff = CompareRoster(first, last)
    If Len(diff) > 0 Then
        RunScenario = diff
        Exit Function
    End If
    diff = CompareReview(first, last)
    If Len(diff) > 0 Then
        RunScenario = diff
        Exit Function
    End If
    diff = CompareSummary(first, last)
    If Len(diff) > 0 Then
        RunScenario = diff
        Exit Function
    End If

    chk = modReview.CheckRules()
    If Len(chk) > 0 Then
        RunScenario = "check rules: " & FirstLine(chk)
        Exit Function
    End If
    RunScenario = ""
End Function

' ------------------------------------------------------------------
' Entry points
' ------------------------------------------------------------------

' Returns "PASS: <n> scenarios" or one line per failing scenario, joined with
' line feeds. Never shows a dialog.
Public Function SelfTestSilent() As String
    Dim r As Long
    Dim last As Long
    Dim n As Long
    Dim nm As String
    Dim diff As String
    Dim en As Long
    Dim ed As String

    On Error GoTo Fail
    mFails = ""
    mCurrent = "(Test sheet)"
    If Not LoadSheet() Then
        SelfTestSilent = "FAIL: Test sheet is empty"
        Exit Function
    End If
    n = 0
    r = 1
    Do While r <= mRows
        nm = CellText(r, 1)
        If Len(nm) = 0 Then
            r = r + 1
        Else
            last = r
            Do While last < mRows
                If StrComp(CellText(last + 1, 1), nm, vbBinaryCompare) <> 0 Then Exit Do
                last = last + 1
            Loop
            mCurrent = nm
            n = n + 1
            diff = RunScenario(r, last)
            If Len(diff) > 0 Then AddFail "FAIL " & nm & ": " & diff
            r = last + 1
        End If
    Loop
    If n = 0 Then
        SelfTestSilent = "FAIL: Test sheet is empty"
    ElseIf Len(mFails) = 0 Then
        SelfTestSilent = "PASS: " & CStr(n) & " scenarios"
    Else
        SelfTestSilent = mFails
    End If
    Exit Function
Fail:
    en = Err.Number
    ed = Err.Description
    AddFail "FAIL " & mCurrent & ": runtime error " & CStr(en) & " " & ed
    SelfTestSilent = mFails
End Function

Public Sub RunSelfTestInteractive()
    Dim res As String

    res = SelfTestSilent()
    modMain.ShowMessages "Self-test", res
End Sub
